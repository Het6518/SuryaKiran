# Copy to `.env` in the repo root. Both the backend and the ML service read it.

# PostgreSQL connection string (e.g. Neon). Required by the backend.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# Secret used to sign login tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me

# Google Gemini key for the AI Copilot (optional — Copilot falls back to a canned reply without it)
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# Backend
PORT=5000
ML_SERVICE_URL=http://localhost:5001

# ML service
ML_PORT=5001
# ML_DEBUG=1
